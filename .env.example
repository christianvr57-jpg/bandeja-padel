# Copia este fichero a .env (o define las variables en tu hosting).
# Sin DATABASE_URL se usa PGlite (PostgreSQL embebido) en ./.data: ideal para probar en local.
PORT=3000
# DATABASE_URL=postgres://usuario:clave@host:5432/bandeja
# PUBLIC_URL=https://tu-dominio.com
SEED_DEMO=true

# Envío de emails (opcional). Sin SMTP, los emails se registran pero no se envían
# y el enlace privado se muestra en pantalla al inscribirse.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASS=contraseña-de-aplicación
# MAIL_FROM="Torneos Club <tu-cuenta@gmail.com>"
